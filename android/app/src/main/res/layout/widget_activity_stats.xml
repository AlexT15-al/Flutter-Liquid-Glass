<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/widget_rings"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:contentDescription="@string/widget_rings" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout style="@style/HaloWidgetCompactRow">
            <ImageView
                style="@style/HaloWidgetCompactIcon"
                android:src="@drawable/ic_widget_steps" />
            <TextView
                android:id="@+id/widget_steps"
                style="@style/HaloWidgetCompactValue" />
        </LinearLayout>

        <LinearLayout style="@style/HaloWidgetCompactRow">
            <ImageView
                style="@style/HaloWidgetCompactIcon"
                android:src="@drawable/ic_widget_move" />
            <TextView
                android:id="@+id/widget_move"
                style="@style/HaloWidgetCompactValue" />
        </LinearLayout>

        <LinearLayout style="@style/HaloWidgetCompactRow">
            <ImageView
                style="@style/HaloWidgetCompactIcon"
                android:src="@drawable/ic_widget_exercise" />
            <TextView
                android:id="@+id/widget_exercise"
                style="@style/HaloWidgetCompactValue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
